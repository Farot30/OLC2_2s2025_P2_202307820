String generarMensaje(int calificacion) {
    calificacion -= 5;
    String resultado = "Generar mensaje Estudiante: Carlos Perez - Calificación: " + String.valueOf(calificacion);
    if (calificacion >= 90) {
        resultado = resultado + " - EXCELENTE";
    } else if (calificacion >= 80) {
        resultado = resultado + " - MUY BUENO";
    } else {
        resultado = resultado + " - REGULAR";
    }
    return resultado;
}

public static void main(){

System.out.println("hola mundo solo declaracioń de funciones");

